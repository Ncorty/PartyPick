# Copy to .env and replace each value before starting Compose.
SITE_ADDRESS=partypick.example
PUBLIC_ORIGIN=https://partypick.example
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=

# Optional host bindings. Keep public 80/443 for automatic certificates.
PUBLISH_IP=0.0.0.0
HTTP_BIND=80
HTTPS_BIND=443
